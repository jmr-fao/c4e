# .gitignore file for git projects containing Stata files

# Stata files
*.dta
*.gph
*.log
*.smcl
*.stpr
*.stsem
*.stswp


# == R files ==
*.Rhistory
*Rproj.user
*Rproj.user/
*.RData
*.Rdata
*.rds
*.RDS
DS_Store


# == Quarto file ==
*.quarto
*.httr-oauth

# == Geo files ==
*.nc
*.tif
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.fbn
*.fbx
*.ain
*.aih
*.xml
*.atx
*.geojson

.Rproj.user
vignettes/.DS_Store
.DS_Store

# Synthetic fixtures for tests and examples (dev/make_fixtures.R); real data stays ignored
!inst/extdata/*.tif
!inst/extdata/*.gpkg

# v1 reference outputs for the tests (dev/make_references.R)
!tests/testthat/fixtures/*.rds

# pkgdown site and rendered vignettes (built in CI)
docs/
inst/doc
vignettes/*.html
vignettes/*_files
vignettes/articles/*.html
vignettes/articles/*_files
